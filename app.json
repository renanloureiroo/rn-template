{
  "slug": "RnTemplate",
  "version": "0.0.1",
  "orientation": "default",
  "userInterfaceStyle": "automatic",
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "newArchEnabled": true,
  "jsEngine": "hermes",
  "assetBundlePatterns": ["**/*"],
  "android": {
    "allowBackup": false,
    "edgeToEdgeEnabled": true
  },
  "ios": {
    "supportsTablet": true,
    "config": {
      "usesNonExemptEncryption": false
    }
  },
  "web": {
    "favicon": "./assets/images/app-icon-web-favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-router",
    "expo-localization",
    "expo-font",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/app-icon-android-adaptive-foreground.png",
        "imageWidth": 300,
        "resizeMode": "contain",
        "backgroundColor": "#191015"
      }
    ],
    "expo-build-properties",
    "./plugins/with-xcode-identity"
  ],
  "experiments": {
    "tsconfigPaths": true
  }
}
