# Variáveis EXPO_PUBLIC_* são embutidas no bundle: nunca coloque segredo aqui.

# Fonte de dados da feature de exemplo (notas): "local" (MMKV, padrão) ou "remote" (API).
EXPO_PUBLIC_NOTES_DATA_SOURCE=local

# API do nestjs-hexagonal-template ou do spring-boot-hexagonal-template. No emulador Android,
# use http://10.0.2.2:8080/api ou rode `npm run adb` para manter localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
