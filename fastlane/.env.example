# Copie para fastlane/.env (fora do git). Caminhos relativos à raiz do projeto.

# App Store Connect API (Usuários e acesso › Integrações › App Store Connect API).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=../secrets/AuthKey_XXXXXXXXXX.p8

# Repositório privado do fastlane match com certificados e perfis do iOS.
MATCH_GIT_URL=git@github.com:<usuario>/<app>-certificates.git
MATCH_PASSWORD=

# Conta de serviço do Google Play com acesso ao app.
PLAY_JSON_KEY_PATH=../secrets/google-play.json

# Firebase App Distribution: ids dos apps da versão Dev (Configurações do projeto › Seus apps).
# Só a distribuição usa o Firebase; o app não precisa do SDK dele.
FIREBASE_APP_ID_IOS=
FIREBASE_APP_ID_ANDROID=
# Grupos de testadores que recebem a Dev, separados por vírgula.
FIREBASE_TESTER_GROUPS=testers
