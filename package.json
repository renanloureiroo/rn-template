{
  "name": "rn-template",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:clean": "expo prebuild --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:architecture": "depcruise src --config .dependency-cruiser.js",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "maestro test -e MAESTRO_APP_ID=com.rntemplate .maestro/flows",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo/bundle-check",
    "verify": "npm run lint && npm run lint:architecture && npm run typecheck && npm test && npm run bundle:check",
    "align-deps": "expo install --fix",
    "depcruise:graph": "depcruise src --include-only \"^src\" --config .dependency-cruiser.js --output-type archi | dot -T svg > dependency-graph.svg",
    "adb": "adb reverse tcp:8080 tcp:8080 && adb reverse tcp:8081 tcp:8081",
    "build:ios:sim": "eas build --profile development --platform ios --local",
    "build:ios:device": "eas build --profile development:device --platform ios --local",
    "build:ios:preview": "eas build --profile preview --platform ios --local",
    "build:ios:prod": "eas build --profile production --platform ios --local",
    "build:android:sim": "eas build --profile development --platform android --local",
    "build:android:device": "eas build --profile development:device --platform android --local",
    "build:android:preview": "eas build --profile preview --platform android --local",
    "build:android:prod": "eas build --profile production --platform android --local"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.25",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@rozenite/network-activity-plugin": "^2.7.0",
    "@rozenite/react-navigation-plugin": "^2.7.0",
    "@rozenite/storage-plugin": "^2.7.0",
    "@rozenite/tanstack-query-plugin": "^2.7.0",
    "@tanstack/query-sync-storage-persister": "^5.108.1",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-query-persist-client": "^5.108.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^27.2.2",
    "intl-pluralrules": "^2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.14",
    "@rozenite/metro": "^2.7.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.5.2",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.10.1",
    "test-renderer": "~1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Template de app React Native (Expo) organizado por feature com MVVM, design system sobre Expo UI, TanStack Query e Zustand"
}
